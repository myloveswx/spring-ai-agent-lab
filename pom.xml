<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.agentlab</groupId>
    <artifactId>spring-ai-agent-lab</artifactId>
    <version>1.0.0</version>
    <name>spring-ai-agent-lab</name>
    <description>Spring AI 2.0 渐进式 Agent 学习项目（8 个阶段）</description>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- MyBatis-Plus：必须用 spring-boot4-* 这个 artifact。
             3.5.12 及以前的 spring-boot3-starter 依赖 spring-boot 3.x，
             在 Spring Boot 4（Spring Framework 7）下会因 starter 元数据与
             自动配置条件不匹配而装配失败。 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <!-- Swagger / OpenAPI 文档。
             springdoc-openapi 的版本线是跟着 Spring Boot 大版本走的：
               2.8.x → Spring Boot 3.x
               3.x   → Spring Boot 4.x（官方 pom 的 parent 就是 spring-boot-starter-parent 4.1.0）
             所以在 Boot 4.1.1 上必须用 3.x，用 2.8.x 会在自动配置阶段直接报
             NoClassDefFoundError / 条件注解不匹配。 -->
        <springdoc.version>3.1.1</springdoc.version>
        <!-- 编码三层统一：源码 / 编译产物 / 报告输出全部 UTF-8。
             Windows 平台默认编码常为 GBK，若不显式声明，
             源码里的中文注释与字符串会在编译期就被破坏（第三层）。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- Web：提供 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（@Valid / @NotBlank 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 可观测性：Actuator + Micrometer（Stage 4 观测 advisor 的执行） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Swagger / OpenAPI 3 接口文档（UI 版：自带 Swagger UI 静态资源）
             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
             artifactId 里的 webmvc 是关键：
               - springdoc-openapi-starter-webmvc-ui  → Spring MVC（servlet），本项目用这个
               - springdoc-openapi-starter-webflux-ui → WebFlux（响应式），本项目不用
             这个 starter 会带来三样东西：
               1) springdoc 的自动配置（扫描 @RestController，生成 OpenAPI 模型）
               2) swagger-core-jakarta（注解 @Tag/@Operation/@Schema 与模型类）
               3) webjars 形式的 Swagger UI（/swagger-ui/index.html）
             探针端点：/v3/api-docs（OpenAPI JSON）、/swagger-ui/index.html（可视化界面） -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Stage 1-3：DeepSeek 对话模型（OpenAI 兼容协议） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>

        <!-- Stage 6：渐进式工具披露（ToolSearchToolCallingAdvisor） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-tool-search-advisor</artifactId>
        </dependency>

        <!-- Stage 7：MCP 客户端（Model Context Protocol），默认不启用 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- Stage 8：RAG 知识库（L1 朴素 RAG）
             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
             两块拼图，缺一不可：

             (1) spring-ai-starter-model-transformers —— 「嵌入模型」
                 在本地用 ONNX Runtime 跑 HuggingFace 的 Transformers 模型，
                 也就是把一段文本变成一串 float 向量。
                 ★ 选它的原因：RAG 必须要有 EmbeddingModel，而 DeepSeek 官方
                   **不提供** embedding 接口（spring-ai-starter-model-deepseek
                   里根本没有 embed 相关的类）。所以嵌入只能另找一家：
                   OpenAI / 智谱 / 通义 / 或者——本方案——完全离线本地跑。
                 它带进来的关键依赖：
                   - com.microsoft.onnxruntime:onnxruntime（含各平台原生库）
                   - ai.djl.huggingface:tokenizers（分词器，读 tokenizer.json）
                   - com.knuddels:jtokkit（TokenTextSplitter 切块要用）

             (2) spring-ai-vector-store-advisor —— 「检索 + 增强」
                 提供 QuestionAnswerAdvisor：请求进来时先拿用户问题去向量库
                 检索 topK 片段，再把片段拼进 Prompt 交给大模型。
                 它自身依赖 spring-ai-vector-store，所以 SimpleVectorStore
                 （内存向量库，可 save/load 到文件）也一起来了。

             注意：这个 artifact 里**只有类、没有自动配置**（不含
             META-INF/spring/...AutoConfiguration.imports），
             所以 QuestionAnswerAdvisor / VectorStore 都需要我们自己声明成 Bean。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-transformers</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>

        <!-- Stage 2 进阶：持久层改用 MyBatis-Plus
             ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
             注意这里**故意不再引入** spring-ai-starter-model-chat-memory-repository-jdbc。
             那个 starter 会带来两块东西：
               1) spring-ai-autoconfigure-model-chat-memory  → ChatMemory 自动装配
               2) spring-ai-autoconfigure-model-chat-memory-repository-jdbc
                                                             → JdbcChatMemoryRepository
             我们只保留第 1 块的等价能力（自己声明 ChatMemory Bean），
             第 2 块改由 com.agentlab.persistence 下的 MyBatis-Plus 实现提供。

             mybatis-plus-spring-boot4-starter 自带 spring-boot-starter-jdbc，
             所以 DataSource / 事务管理器 / JdbcTemplate 依然可用。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动（版本由 Spring Boot BOM 统一管理，无需写 version） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 编译期显式指定 UTF-8，不依赖平台默认值（Windows 默认可能是 GBK） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <!-- 2.0.x 已在 Maven Central，此处保留 milestone 仓库以便切换到 2.1.0-Mx -->
        <repository>
            <id>spring-milestones</id>
            <name>Spring Milestones</name>
            <url>https://repo.spring.io/milestone</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
